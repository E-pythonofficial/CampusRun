generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum Role {
  REQUESTER
  DISPATCHER
  ADMIN
}

enum UserType {
  STUDENT
  STAFF
}

enum DeliveryStatus {
  PENDING
  PENDING_PAYMENT
  PAID
  ACCEPTED
  PICKED_UP
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  NOT_APPLIED        //regular students
  PENDING_REVIEW      //email verified, awiting admin Approval
  INTERVIEW_SCHEDULED  //admin sent google meet link
  APPROVED              //passed interview, full access to dashboard
  REJECTED             //rejected at the review stage
  REJECTED_POST_INTERVIEW  //rejected after interview
}

// --- MODELS ---

model User {
  id                String    @id @default(uuid())
  email             String    @unique @db.VarChar(255)
  password          String
  fullName          String    @db.VarChar(255)
  username          String?   @unique @db.VarChar(50)
  role              Role      @default(REQUESTER)
  userType          UserType  @default(STUDENT)
  
  // Academic & Staff Identity
  matricNumber      String?   @unique @db.VarChar(50)
  staffIdUsername   String?   @unique @db.VarChar(50)
  department        String?   @db.VarChar(100)
  college           String?   @db.VarChar(100)
  hostel            String?   @db.VarChar(100)
  
  // Dispatcher Info
  idCardUrl         String?   @db.VarChar(500)
  selfieUrl         String?   @db.VarChar(500)
  applicationStatus  ApplicationStatus @default(NOT_APPLIED)
  reasonToJoin      String?   @db.Text
  interviewLink     String?   @db.VarChar(500)
  interviewScheduledAt   DateTime?
  rejectionReason   String?   @db.Text
  applicationSubmittedAt  DateTime?
  approvedAt  DateTime?  // when admin approved them

  //AI Verification RESULTS
  aiIdCardReal      Boolean?    //result of AI Id card check
  aiFaceMatchScore  Float?      //0.0 - 1.0 face match confidence
  aiVerificationFlag  Boolean?  //true = flagged for review
  
  // Auth & Verification
  isVerified        Boolean   @default(false)
  verificationToken String?   @unique @db.VarChar(255)
  tokenExpires      DateTime?
  resetToken        String?   @unique @db.VarChar(255)
  resetTokenExpires DateTime?
  isApproved        Boolean   @default(false)

  // Earnings (dispatcher)
  weeklyBalance     Decimal   @default(0) @db.Decimal(10, 2)
  totalEarned       Decimal   @default(0) @db.Decimal(10, 2)
  lastPayoutAt  DateTime?

  // For REQUESTER users they stay null/false always
  isSuspended           Boolean   @default(false)
  suspendedUntil        DateTime?
  suspensionReason      String?   @db.Text

  // Relations
  deliveries        Delivery[]    @relation("Requester")
  runs              Delivery[]    @relation("Runner")
  loginRecords      LoginRecord[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([email])
  @@index([resetToken])
}

model LoginRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  loginAt   DateTime @default(now())

  @@index([userId])
}


model Delivery {
  id             String         @id @default(uuid())
  item           String         @db.VarChar(255)
  
  handshakePin  String?         @db.VarChar(10) // 4-digit PIN for delivery confirmation
  // Location
  pickupAddress  String         @db.Text
  pickupLat      Float
  pickupLng      Float
  dropoffAddress String         @db.Text
  dropoffLat     Float
  dropoffLng     Float

  // Pricing
  distanceMeters Int
  totalPrice     Decimal        @db.Decimal(10, 2)
  runnerGets     Decimal        @db.Decimal(10, 2)
  companyRevenue Decimal        @db.Decimal(10, 2)


  // Payment
  status         DeliveryStatus @default(PENDING)
  paystackRef    String?        @unique @db.VarChar(255)
  
  // Relations
  requesterId    String
  requester      User           @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  runnerId       String?
  runner         User?          @relation("Runner", fields: [runnerId], references: [id], onDelete: SetNull)
  
  deliveredAt    DateTime?      // timestamp when delivery was confirmed
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([runnerId])
  @@index([paystackRef])
}

model Otp {
  id        String   @id @default(uuid())
  email     String   @db.VarChar(255)
  code      String   @db.VarChar(10)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}