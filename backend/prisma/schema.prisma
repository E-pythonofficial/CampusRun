generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum Role {
  REQUESTER
  DISPATCHER
  ADMIN
}

enum UserType {
  STUDENT
  STAFF
}

enum DeliveryStatus {
  PENDING
  PAID
  ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

// --- MODELS ---

model User {
  id                String    @id @default(uuid())
  email             String    @unique @db.VarChar(255)
  password          String
  fullName          String    @db.VarChar(255)
  username          String?   @unique @db.VarChar(50)
  role              Role      @default(REQUESTER)
  userType          UserType  @default(STUDENT)
  
  // Academic & Staff Identity
  matricNumber      String?   @unique @db.VarChar(50)
  staffIdUsername   String?   @unique @db.VarChar(50)
  department        String?   @db.VarChar(100)
  college           String?   @db.VarChar(100)
  hostel            String?   @db.VarChar(100)
  
  // --- DISPATCHER SPECIFIC INFO ---
  bio               String?   @db.Text         // "Why do you want to join?"
  idCardUrl         String?   @db.VarChar(500) // Path to uploaded ID card image
  selfieUrl         String?   @db.VarChar(500) // Path to uploaded verification selfie
  
  // Auth & Verification
  isVerified        Boolean   @default(false)  // Email verification status
  verificationToken String?   @unique @db.VarChar(255)
  tokenExpires      DateTime? 
  resetToken        String?   @unique @db.VarChar(255)
  resetTokenExpires DateTime? 
  
  // Admin Approval: Requesters can be true by default, Dispatchers start as false
  isApproved        Boolean   @default(false) 

  // Relations
  deliveries        Delivery[]    @relation("Requester")
  runs              Delivery[]    @relation("Runner")
  loginRecords      LoginRecord[] 
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([email])
  @@index([resetToken])
}

model LoginRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  loginAt   DateTime @default(now())

  @@index([userId])
}

model Delivery {
  id             String         @id @default(uuid())
  item           String         @db.VarChar(255)
  
  // Location Data
  pickupAddress  String         @db.Text
  pickupLat      Float
  pickupLng      Float
  
  dropoffAddress String         @db.Text
  dropoffLat     Float
  dropoffLng     Float

  // Pricing & Metrics
  distanceMeters Int
  totalPrice     Decimal        @db.Decimal(10, 2)
  
  // Tracking
  status         DeliveryStatus @default(PENDING)
  paystackRef    String?        @unique @db.VarChar(255)
  
  // Relations
  requesterId    String
  requester      User           @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  
  runnerId       String?
  runner         User?          @relation("Runner", fields: [runnerId], references: [id], onDelete: SetNull)
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([runnerId])
}

model Otp {
  id        String   @id @default(uuid())
  email     String   @db.VarChar(255)
  code      String   @db.VarChar(10)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}